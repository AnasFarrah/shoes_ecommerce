{% extends 'base.html.twig' %}

{% block title %}ShoeStore - {{ product.nom }}{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row">
            <!-- Product Images -->
            <div class="col-md-6">
                <div class="card mb-4">
                    <img src="{{ asset('images/chaussures/' ~ product.image) }}" class="card-img-top product-image" alt="{{ product.nom }}">
                    <div class="card-body">
                        <div class="row g-2">
                            <div class="col-3">
                                <img src="{{ asset('images/chaussures/' ~ product.image) }}" class="img-thumbnail" alt="Vue 1">
                            </div>
                            <div class="col-3">
                                <img src="{{ asset('images/chaussures/' ~ product.image) }}" class="img-thumbnail" alt="Vue 2">
                            </div>
                            <div class="col-3">
                                <img src="{{ asset('images/chaussures/' ~ product.image) }}" class="img-thumbnail" alt="Vue 3">
                            </div>
                            <div class="col-3">
                                <img src="{{ asset('images/chaussures/' ~ product.image) }}" class="img-thumbnail" alt="Vue 4">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Product Details -->
            <div class="col-md-6">
                <div class="card">
                    <div class="card-body">
                        <h1 class="card-title h2 mb-3">{{ product.nom }}</h1>
                        <div class="d-flex align-items-center mb-3">
                            <span class="badge bg-brown me-2">{{ product.categorie.nom }}</span>
                            <div class="text-warning">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star-half-alt"></i>
                                <span class="text-muted">(4.5)</span>
                            </div>
                        </div>
                        <h2 class="h3 mb-4">{{ product.prix }} €</h2>

                        <div class="mb-4">
                            <h5 class="mb-3">Détails du produit</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <p><strong>Marque:</strong> {{ product.details.marque ?? 'Non spécifié' }}</p>
                                    <p><strong>Couleur:</strong> {{ product.details.couleur ?? 'Non spécifié' }}</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Matière:</strong> {{ product.details.matiere ?? 'Non spécifié' }}</p>
                                    <p><strong>Type de semelle:</strong> {{ product.details.type_semelle ?? 'Non spécifié' }}</p>
                                </div>
                            </div>
                        </div>

                        <form class="mb-4">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Taille</label>
                                    <select class="form-select">
                                        {% for size in 36..47 %}
                                            <option value="{{ size }}">{{ size }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Quantité</label>
                                    <input type="number" class="form-control" value="1" min="1" max="{{ product.stock }}">
                                </div>
                            </div>
                        </form>

                        <div class="d-grid gap-2">
                            <button class="btn btn-primary btn-lg">
                                <i class="fas fa-shopping-cart me-2"></i>Ajouter au panier
                            </button>
                            <button class="btn btn-outline-primary">
                                <i class="fas fa-heart me-2"></i>Ajouter aux favoris
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Description -->
        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title mb-4">Description</h3>
                        <p class="card-text">{{ product.description }}</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Related Products -->
        <div class="row mt-5">
            <div class="col-12">
                <h3 class="mb-4">Produits similaires</h3>
                <div class="row g-4">
                    {% for relatedProduct in relatedProducts %}
                        <div class="col-md-3">
                            <div class="card h-100">
                                <img src="{{ asset('images/chaussures/' ~ relatedProduct.image) }}" class="card-img-top product-image" alt="{{ relatedProduct.nom }}">
                                <div class="card-body">
                                    <h5 class="card-title">{{ relatedProduct.nom }}</h5>
                                    <p class="card-text">{{ relatedProduct.prix }} €</p>
                                    <a href="{{ path('app_product_show', {'id': relatedProduct.id}) }}" class="btn btn-primary w-100">Voir détails</a>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block stylesheets %}
    <style>
        .bg-brown {
            background-color: #8B4513;
        }

        .product-image {
            width: 100%;
            object-fit: cover;
        }
    </style>
{% endblock %} 