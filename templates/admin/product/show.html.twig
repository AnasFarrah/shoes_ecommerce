{% extends 'base.html.twig' %}

{% block title %}Détails du Produit{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-body p-5">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h1 class="h3">Détails du Produit</h1>
                        <div class="btn-group">
                            <a href="{{ path('app_admin_product_edit', {'id': produit.id}) }}" class="btn btn-warning">
                                <i class="fas fa-edit me-2"></i>Modifier
                            </a>
                            <a href="{{ path('app_admin_product_index') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-2"></i>Retour
                            </a>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            {% if produit.image %}
                                <img src="{{ asset('uploads/images/' ~ produit.image) }}" alt="{{ produit.nom }}" class="img-fluid rounded mb-4">
                            {% else %}
                                <div class="bg-light rounded d-flex align-items-center justify-content-center mb-4" style="height: 300px;">
                                    <i class="fas fa-image fa-3x text-muted"></i>
                                </div>
                            {% endif %}
                        </div>
                        <div class="col-md-6">
                            <h2 class="h4 mb-3">{{ produit.nom }}</h2>
                            <p class="text-muted mb-4">{{ produit.description }}</p>
                            
                            <div class="mb-3">
                                <strong>Prix :</strong> {{ produit.prix }} €
                            </div>
                            <div class="mb-3">
                                <strong>Stock :</strong> {{ produit.stock }}
                            </div>
                            <div class="mb-3">
                                <strong>Catégorie :</strong> {{ produit.categorie.nom }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 